#!/usr/bin/env python3
"""Slice an STL with CuraEngine and report the slicer's G-code metadata."""
import json
import os
import shutil
import subprocess
import sys


def main():
    if len(sys.argv) not in (2, 3):
        raise SystemExit("Usage: unire-slice <model.stl> [output.gcode]")
    model = os.path.abspath(sys.argv[1])
    if not os.path.isfile(model):
        raise SystemExit(f"STL not found: {model}")
    output = os.path.abspath(sys.argv[2] if len(sys.argv) == 3 else os.path.splitext(model)[0] + ".gcode")
    engine = os.environ.get("CURAENGINE", "CuraEngine")
    if not shutil.which(engine) and not os.path.isfile(engine):
        raise SystemExit(f"CuraEngine not found: {engine}")

    here = os.path.dirname(os.path.realpath(__file__))
    profiles = os.environ.get("UNIRE_HARDWARE_PROFILE_DIR", os.path.join(here, "..", "profiles"))
    with open(os.path.join(profiles, "petg_0.2mm.json"), encoding="utf-8") as handle:
        profile = json.load(handle)
    command = [engine, "slice", "-v", "-j", os.path.join(profiles, "fdmprinter.def.json"),
               "-j", os.path.join(profiles, "fdmextruder.def.json")]
    for key, value in profile["settings"].items():
        command.extend(["-s", f"{key}={value}"])
    command.extend(["-e0", "-l", model, "-o", output])
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            timeout=120, check=False)
    if result.returncode:
        sys.stderr.write(result.stdout)
        raise SystemExit(f"CuraEngine failed with exit code {result.returncode}")
    if not os.path.isfile(output) or os.path.getsize(output) == 0:
        raise SystemExit("CuraEngine returned success but did not write G-code")
    values = {}
    for line in result.stdout.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip()
    print_time = values.get("Print time (s)", "unknown")
    layers = values.get("Layer count", "unknown")
    filament_mm3 = values.get("Filament (mm^3)", "unknown")
    try:
        filament_m = float(filament_mm3) / (3.141592653589793 * (float(profile["settings"]["material_diameter"]) / 2) ** 2) / 1000
        filament = f"{filament_mm3} mm^3 (about {filament_m:.2f} m of {profile['settings']['material_diameter']} mm filament)"
    except (ValueError, KeyError):
        filament = f"{filament_mm3} mm^3"
    print(f"Slicer: CuraEngine 4.x; generic PETG profile ({profile['description']})")
    print(f"Output: {output} ({os.path.getsize(output)} bytes)")
    print(f"Estimated print time: {print_time} s (slicer estimate)")
    print(f"Layer count: {layers}")
    print(f"Filament: {filament} (slicer estimate)")
    print(f"Layer height: {profile['settings']['layer_height']} mm")
    print("Time, layer count, and material volume are parsed from CuraEngine's slice output; G-code header estimates are not used.")


if __name__ == "__main__":
    main()
