#!/bin/sh
# unire: ask Unire (the program running this session) to do something.
# It only writes requests to files; Unire reads them and decides what to do.
#   unire name "<title>"      give the conversation a title (read when the session ends)
#   unire ask "<question>"    ask the owner and wait for the answer
#   unire wait <number>       keep waiting for the answer to an earlier question
#   unire pr "<title>"        suggest a pull request title (read when the session ends)
#   unire share <file>        show a file (text or image) to the owner in the chat
#   unire pr-body <<EOF ... EOF   the pull request description, from standard input
#   unire pr-status, pr-comments, pr-reply "<text>", memory "<words>", repo "<name>", parent   answered by Unire while the agent runs
dir=/workspace/.unire-tools
tool=$1
[ -n "$tool" ] || { echo "usage: unire <tool> <text>" >&2; exit 2; }
shift
case "$tool" in
  *[!a-z-]*) echo "unire: bad tool name" >&2; exit 2 ;;
esac

# Agents stop a command that runs for too long, so wait in short rounds.
wait_for() {
  n=0
  while [ "$n" -lt 90 ]; do
    if [ -f "$dir/ask/$1.a" ]; then cat "$dir/ask/$1.a"; return 0; fi
    sleep 2
    n=$((n + 2))
  done
  echo "The owner has not answered yet (question $1). Run: unire wait $1   to keep waiting, or go on with your best judgment and say what you assumed."
}

case "$tool" in
  ask)
    [ -n "$*" ] || { echo "usage: unire ask \"<question>\"" >&2; exit 2; }
    id=$(date +%s%N)
    mkdir -p "$dir/ask" || exit 1
    printf '%s\n' "$*" > "$dir/ask/$id.q.tmp" && mv "$dir/ask/$id.q.tmp" "$dir/ask/$id.q" || exit 1
    wait_for "$id"
    ;;
  name)
    [ -n "$*" ] || { echo "usage: unire name \"<title>\"" >&2; exit 2; }
    mkdir -p "$dir" && printf '%s\n' "$*" | tr '\n' ' ' >> "$dir/name" && printf '\n' >> "$dir/name"
    id=$(date +%s%N)
    mkdir -p "$dir/ask" || exit 1
    printf '@call %s\n%s\n' "$tool" "$*" > "$dir/ask/$id.q.tmp" && mv "$dir/ask/$id.q.tmp" "$dir/ask/$id.q" || exit 1
    echo "ok: Unire has your 'name' request and will update the title."
    ;;
  pr-status|pr-logs|pr-comments|pr-reply|pr-close|pr-reopen|memory|repo|parent)
    # Unire answers these while the agent runs (see "@call" in internal/workflow/ask.go).
    id=$(date +%s%N)
    mkdir -p "$dir/ask" || exit 1
    printf '@call %s\n%s\n' "$tool" "$*" > "$dir/ask/$id.q.tmp" && mv "$dir/ask/$id.q.tmp" "$dir/ask/$id.q" || exit 1
    wait_for "$id"
    ;;
  share)
    # Copy the file now (the agent may change or delete it later). Layout: name, kind, content.
    f=$1
    case "$f" in
      file://*) f=${f#file://} ;;
    esac
    f="${f%%#*}"
    [ -f "$f" ] || { echo "unire share: no such file: $f" >&2; exit 2; }
    name=$(basename -- "$f" | tr -d '\r\n')
    case "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" in
      *.png|*.jpg|*.jpeg|*.gif|*.webp) kind=image; max=1048576 ;;
      *) kind=text; max=204800 ;;
    esac
    size=$(wc -c < "$f")
    [ "$size" -le "$max" ] || { echo "unire share: $name is $size bytes; the limit is $max for this kind of file" >&2; exit 2; }
    if [ "$kind" = text ] && [ "$(head -c 8192 "$f" | tr -d '\000' | wc -c)" -ne "$(head -c 8192 "$f" | wc -c)" ]; then
      echo "unire share: $name looks like a binary file; only text and png/jpg/gif/webp images can be shared" >&2; exit 2
    fi
    mkdir -p "$dir/share" || exit 1
    [ "$(ls -1 "$dir/share" | grep -c '\.s$')" -lt 10 ] || { echo "unire share: at most 10 files per turn" >&2; exit 2; }
    id=$(date +%s%N)
    { printf '%s\n%s\n' "$name" "$kind"; if [ "$kind" = image ]; then base64 < "$f" | tr -d '\n'; else cat "$f"; fi; } > "$dir/share/$id.tmp" \
      && mv "$dir/share/$id.tmp" "$dir/share/$id.s" \
      && echo "ok: $name will be shown to the owner in the chat when your turn ends."
    ;;
  pr-body)
    # The description has several lines, so it is read from standard input.
    mkdir -p "$dir" || exit 1
    head -c 8000 > "$dir/pr-body.tmp" && mv "$dir/pr-body.tmp" "$dir/pr-body" \
      && echo "ok: Unire has your pull request description and will use it if the owner opens a pull request."
    ;;
  wait)
    case "$1" in
      ''|*[!0-9]*) echo "usage: unire wait <number>" >&2; exit 2 ;;
    esac
    wait_for "$1"
    ;;
  *)
    mkdir -p "$dir" && printf '%s\n' "$*" | tr '\n' ' ' >> "$dir/$tool" && printf '\n' >> "$dir/$tool" \
      && echo "ok: Unire has your '$tool' request and will use it when the session ends."
    ;;
esac
